# Web PWA. These are safe to expose to the browser when RLS is enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# MCP server runtime. Do not commit real values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MCP_PUBLIC_URL=http://127.0.0.1:8787/mcp
MCP_PORT=8787
MCP_HOST=127.0.0.1

# Development only. Keep false for any public deployment until OAuth is wired.
MCP_ALLOW_NO_AUTH=false
